# Production — browser URL (your logs used http://192.168.0.24)

# DATABASE_URL for the app is set in docker-compose.yml (not from this file) so a dev-style localhost URL in `.env` cannot break Prisma.
# For an external database, edit the DATABASE_URL line under `app` in docker-compose.yml.

NEXTAUTH_URL="http://192.168.0.24"
NEXTAUTH_SECRET="your-production-secret-key-change-this"

ALLOWED_ORIGINS="http://192.168.0.24,http://localhost,http://127.0.0.1"

NEXT_PUBLIC_APP_URL="http://192.168.0.24"
NEXT_PUBLIC_CMS_URL="http://192.168.0.24"

NODE_ENV="production"
